# ============ 访问 ============

# 域名：提前把域名 A 记录解析到服务器 IP，Caddy 会自动申请 HTTPS 证书
DD_DOMAIN=dd.example.com

# 管理员密码：只有这个密码能进设置页、改密码、改模型配置
DD_INITIAL_PASSWORD=换成你的管理员密码

# 访客密码（可选）：给别人用，只能上传和看报告，进不了设置页
# 不填就不开放访客登录；之后也能在网页「设置」里设置或关闭
DD_GUEST_PASSWORD=

# 上传大小上限（MB）：Flask 和 Caddy 共用这个值，改完两边都生效
DD_MAX_UPLOAD_MB=1024

# Flask session 密钥；留空会自动生成并保存到 data/secret_key
# DD_SECRET_KEY=

# ============ 默认模型（访客没配置自己的模型时用这个）============
# 默认 ollama：不产生 API 费用
DD_LLM_PROVIDER=ollama
DD_LLM_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434

# 要用云端 API 就换成这组（管理员默认）
# DD_LLM_PROVIDER=api
# DD_LLM_BASE_URL=https://api.deepseek.com/v1
# DD_LLM_MODEL=deepseek-chat
# DD_LLM_API_KEY=sk-xxx

DD_LLM_ENABLED=1
